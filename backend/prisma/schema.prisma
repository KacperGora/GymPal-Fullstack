// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ExerciseCategory {
  STRENGTH
  CARDIO
  FLEXIBILITY
  HIIT
}

enum MealCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model User {
  id                   Int                @id @unique @default(autoincrement())
  firstName            String
  lastName             String
  password             String
  email                String             @unique
  failedLoginAttempts  Int                @default(0)
  lockedUntil          DateTime?
  refreshTokens        RefreshToken[]
  meals                Meal[]
  favoriteMeals        FavoriteMeal[]
  userProfile          UserProfile?
  dailyStats           DailyStat[]
  workouts             WorkoutSession[]
  waterIntake          WaterIntake[]
  favoriteExercises    FavoriteExercise[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  familyId  String
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model WaterIntake {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  glasses   Int      @default(0)
  date      DateTime @db.Date
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Meal {
  id        String       @id @default(cuid())
  name      String
  calories  Int
  fats      Float
  proteins  Float
  carbs     Float
  category  MealCategory @default(SNACK)
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  date      DateTime     @default(now())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now())

  @@index([userId])
  @@index([date])
}

model FavoriteMeal {
  id        String       @id @default(cuid())
  name      String
  calories  Int
  fats      Float
  proteins  Float
  carbs     Float
  category  MealCategory @default(SNACK)
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([userId, name, calories, proteins, carbs, fats, category])
}

model UserProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  height    Float
  weight    Float
  age       Int
  activity  Float
  goal      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyStat {
  id       Int      @id @default(autoincrement())
  userId   Int
  date     DateTime @default(now())
  calories Float
  fats     Float
  proteins Float
  carbs    Float
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Exercise {
  id          String           @id @default(cuid())
  name        String           @unique
  category    ExerciseCategory
  muscleGroup String
  equipment   String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model WorkoutSession {
  id             String            @id @default(cuid())
  userId         Int
  user           User              @relation(fields: [userId], references: [id])
  name           String
  date           DateTime          @default(now())
  duration       Int
  caloriesBurned Float
  notes          String?
  exercises      WorkoutExercise[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
}

model WorkoutExercise {
  id               String         @id @default(cuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  wgerExerciseId   Int
  exerciseName     String
  exerciseCategory String?
  sets             Int
  reps             Int
  weight           Float
  restTime         Int
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model FavoriteExercise {
  id              String   @id @default(cuid())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  wgerExerciseId  Int
  name            String
  category        String
  muscles         String
  equipment       String
  imageUrl        String?
  createdAt       DateTime @default(now())

  @@unique([userId, wgerExerciseId])
}
