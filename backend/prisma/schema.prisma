// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Seeder {
  id        String   @id @default(cuid())
  name      String   @unique
  runAt     DateTime @default(now())
  createdAt DateTime @default(now())
}

enum ExerciseCategory {
  STRENGTH
  CARDIO
  FLEXIBILITY
  HIIT
}

enum MealCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model User {
  id                  Int                @id @unique @default(autoincrement())
  firstName           String
  lastName            String
  password            String
  email               String             @unique
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  refreshTokens       RefreshToken[]
  meals               Meal[]
  favoriteMeals       FavoriteMeal[]
  userProfile         UserProfile?
  dailyStats          DailyStat[]
  workouts            WorkoutSession[]
  waterIntake         WaterIntake[]
  favoriteExercises   FavoriteExercise[]
  subscription        Subscription?
  aiRequests          AiRequest[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  familyId  String
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model WaterIntake {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  glasses   Int      @default(0)
  date      DateTime @db.Date
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Meal {
  id        String       @id @default(cuid())
  name      String
  calories  Int
  fats      Float
  proteins  Float
  carbs     Float
  category  MealCategory @default(SNACK)
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  date      DateTime     @default(now())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now())

  @@index([userId])
  @@index([date])
}

model FavoriteMeal {
  id        String       @id @default(cuid())
  name      String
  calories  Int
  fats      Float
  proteins  Float
  carbs     Float
  category  MealCategory @default(SNACK)
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([userId, name, calories, proteins, carbs, fats, category])
}

model UserProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  height    Float
  weight    Float
  age       Int
  activity  Float
  goal      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyStat {
  id       Int      @id @default(autoincrement())
  userId   Int
  date     DateTime @default(now())
  calories Float
  fats     Float
  proteins Float
  carbs    Float
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Exercise {
  id          String           @id @default(cuid())
  name        String           @unique
  category    ExerciseCategory
  muscleGroup String
  equipment   String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model WorkoutSession {
  id             String            @id @default(cuid())
  userId         Int
  user           User              @relation(fields: [userId], references: [id])
  name           String
  date           DateTime          @default(now())
  duration       Int
  caloriesBurned Float
  notes          String?
  exercises      WorkoutExercise[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
}

model WorkoutExercise {
  id               String         @id @default(cuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  wgerExerciseId   Int
  exerciseName     String
  exerciseCategory String?
  sets             Int
  reps             Int
  weight           Float
  restTime         Int
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model FavoriteExercise {
  id             String   @id @default(cuid())
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  wgerExerciseId Int
  name           String
  category       String
  muscles        String
  equipment      String
  imageUrl       String?
  createdAt      DateTime @default(now())

  @@unique([userId, wgerExerciseId])
}

enum IngredientCategory {
  PROTEIN
  CARBS
  VEGETABLES
  FRUITS
  DAIRY
  FATS_OILS
  GRAINS
  LEGUMES
  NUTS_SEEDS
  BEVERAGES
  CONDIMENTS
  OTHER
}

enum MealDifficulty {
  EASY
  MEDIUM
  HARD
}

enum MacroFocus {
  HIGH_PROTEIN
  LOW_CARB
  BALANCED
  HIGH_CARB
  LOW_FAT
}

model Ingredient {
  id                      String                   @id @default(cuid())
  name                    String
  servingSize             Float
  servingUnit             String
  calories                Float
  proteins                Float
  carbs                   Float
  fats                    Float
  fiber                   Float                    @default(0)
  category                IngredientCategory
  verified                Boolean                  @default(false)
  source                  String                   @default("USDA")
  sourceUrl               String?
  verifiedBy              String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  mealTemplateIngredients MealTemplateIngredient[]

  @@unique([name, servingSize, servingUnit])
  @@index([category])
  @@index([verified])
}

model MealTemplate {
  id              String                   @id @default(cuid())
  name            String
  category        MealCategory
  totalCalories   Float
  totalProteins   Float
  totalCarbs      Float
  totalFats       Float
  minScale        Float                    @default(0.5)
  maxScale        Float                    @default(2.0)
  preparationTime Int?
  difficulty      MealDifficulty           @default(EASY)
  macroFocus      MacroFocus               @default(BALANCED)
  translations    Json?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  ingredients     MealTemplateIngredient[]

  @@index([category])
  @@index([macroFocus])
  @@index([totalCalories])
}

model MealTemplateIngredient {
  id           String       @id @default(cuid())
  templateId   String
  ingredientId String
  grams        Float
  scaleable    Boolean      @default(true)
  sortOrder    Int          @default(0)
  template     MealTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id])

  @@unique([templateId, ingredientId])
  @@index([templateId])
  @@index([ingredientId])
}

model CacheEntry {
  key       String   @id
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  stripePriceId String         @unique
  price         Int
  currency      String         @default("pln")
  interval      String
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
  usageLimits   UsageLimit[]
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               Int                @unique
  user                 User               @relation(fields: [userId], references: [id])
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([stripeCustomerId])
}

model PaymentEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
  payload       Json
}

model UsageLimit {
  id         String @id @default(cuid())
  planId     String
  plan       Plan   @relation(fields: [planId], references: [id])
  feature    String
  dailyLimit Int

  @@unique([planId, feature])
}

model AiRequest {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  feature   String
  createdAt DateTime @default(now())

  @@index([userId, feature, createdAt])
}
